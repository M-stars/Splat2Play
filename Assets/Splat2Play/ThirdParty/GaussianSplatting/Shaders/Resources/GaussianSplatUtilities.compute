// SPDX-License-Identifier: MIT
#define GROUP_SIZE 1024

#pragma kernel CSCalcViewData

// DeviceRadixSort
#pragma multi_compile __ KEY_UINT KEY_INT KEY_FLOAT
#pragma multi_compile __ PAYLOAD_UINT PAYLOAD_INT PAYLOAD_FLOAT
#pragma multi_compile __ SHOULD_ASCEND
#pragma multi_compile __ SORT_PAIRS
#pragma multi_compile __ VULKAN
#pragma kernel InitDeviceRadixSort
#pragma kernel Upsweep
#pragma kernel Scan
#pragma kernel Downsweep

// GPU sorting needs wave ops
#pragma require wavebasic
#pragma require waveballot
#pragma use_dxc

#include "DeviceRadixSort.hlsl"
#include "GaussianSplatting.hlsl"
#include "UnityCG.cginc"

float4x4 _MatrixObjectToWorld;
float4x4 _MatrixWorldToObject;
float4x4 _MatrixMV;
float4x4 _MatrixP;
float4x4 _MatrixVP;
float4 _VecScreenParams;
float4 _VecWorldSpaceCameraPos;

RWStructuredBuffer<uint> _SplatSortDistances;
RWStructuredBuffer<uint> _SplatSortKeys;
uint _SplatCount;
uint _SplatOffset;
uint _WriteSortKeys;

// radix sort etc. friendly, see http://stereopsis.com/radix.html
uint FloatToSortableUint(float f)
{
    uint fu = asuint(f);
    uint mask = -((int)(fu >> 31)) | 0x80000000;
    return fu ^ mask;
}

RWStructuredBuffer<SplatViewData> _SplatViewData;

float _SplatScale;
float _SplatOpacityScale;
uint _SHOrder;
uint _SHOnly;

// —— S2P M6:GPU 分块剔除(视锥 + Hi-Z)——
// 仅当 _S2PUseGpuChunkCull != 0 时才允许访问 _S2PChunkVisibleFlags(该缓冲由 C# 保证此时已绑定)
RWStructuredBuffer<uint> _S2PChunkVisibleFlags;
uint _S2PUseGpuChunkCull;

// —— S2P M7:多光源方向性动态重光照(由 S2PLightModulationDriver 每帧注入,上限 8 盏)——
// A: xyz=光源世界坐标, w=1/range²
// B: xyz=朝向(单位向量), w=cos(半锥角);w < -0.999 表示点光源
// C: rgb=线性颜色×强度, w=shininess(如 16..64)
float4 _S2PGpuLightA[8];
float4 _S2PGpuLightB[8];
float4 _S2PGpuLightC[8];
int _S2PDynamicLightCount;
float _S2PPerSplatLightStrength;
float _S2PSplatNormalWeight;

void DecomposeCovariance(float3 cov2d, out float2 v1, out float2 v2)
{
    #if 0 // does not quite give the correct results?

    // https://jsfiddle.net/mattrossman/ehxmtgw6/
    // References:
    // - https://www.youtube.com/watch?v=e50Bj7jn9IQ
    // - https://en.wikipedia.org/wiki/Eigenvalue_algorithm#2%C3%972_matrices
    // - https://people.math.harvard.edu/~knill/teaching/math21b2004/exhibits/2dmatrices/index.html
    float a = cov2d.x;
    float b = cov2d.y;
    float d = cov2d.z;
    float det = a * d - b * b; // matrix is symmetric, so "c" is same as "b"
    float trace = a + d;

    float mean = 0.5 * trace;
    float dist = sqrt(mean * mean - det);

    float lambda1 = mean + dist; // 1st eigenvalue
    float lambda2 = mean - dist; // 2nd eigenvalue

    if (b == 0) {
        // https://twitter.com/the_ross_man/status/1706342719776551360
        if (a > d) v1 = float2(1, 0);
        else v1 = float2(0, 1);
    } else
        v1 = normalize(float2(b, d - lambda2));

    v1.y = -v1.y;
    // The 2nd eigenvector is just a 90 degree rotation of the first since Gaussian axes are orthogonal
    v2 = float2(v1.y, -v1.x);

    // scaling components
    v1 *= sqrt(lambda1);
    v2 *= sqrt(lambda2);

    float radius = 1.5;
    v1 *= radius;
    v2 *= radius;

    #else

    // same as in antimatter15/splat
    float diag1 = cov2d.x, diag2 = cov2d.z, offDiag = cov2d.y;
    float mid = 0.5f * (diag1 + diag2);
    float radius = length(float2((diag1 - diag2) / 2.0, offDiag));
    float lambda1 = mid + radius;
    float lambda2 = max(mid - radius, 0.1);

    // diagonal covariance already has axis-aligned eigenvectors, avoid normalizing (0,0)
    float2 diagVec = offDiag == 0
        ? (diag1 >= diag2 ? float2(1, 0) : float2(0, 1))
        : normalize(float2(offDiag, lambda1 - diag1));
    diagVec.y = -diagVec.y;
    float maxSize = 4096.0;
    v1 = min(sqrt(2.0 * lambda1), maxSize) * diagVec;
    v2 = min(sqrt(2.0 * lambda2), maxSize) * float2(diagVec.y, -diagVec.x);

    #endif
}

[numthreads(GROUP_SIZE,1,1)]
void CSCalcViewData (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    // —— S2P M6 T6.3:所属 Chunk 被剔除 → 直接早退,跳过协方差矩阵/特征分解/球谐求值 ——
    if (_S2PUseGpuChunkCull != 0)
    {
        uint chunkIdx = idx >> 12; // 4096 splats per chunk
        if (_S2PChunkVisibleFlags[chunkIdx] == 0)
        {
            SplatViewData culledView = (SplatViewData)0;
            culledView.pos.x = asfloat(0x7f800000u); // NaN,顶点着色器自动丢弃退化三角形
            _SplatViewData[_SplatOffset + idx] = culledView;
            if (_WriteSortKeys != 0)
            {
                // 升序排序(Near→Far,Front-to-Back Under 混合)中 0xFFFFFFFF 为最大键 → 排到绘制流末尾,
                // 使 DrawProceduralIndirect 以 instanceCount=可见数 即可精确跳过
                _SplatSortDistances[_SplatOffset + idx] = 0xFFFFFFFFu;
                _SplatSortKeys[_SplatOffset + idx] = _SplatOffset + idx;
            }
            return;
        }
    }

    SplatData splat = LoadSplatGeometry(idx);
    SplatViewData view = (SplatViewData)0;
    
    float3 centerWorldPos = mul(_MatrixObjectToWorld, float4(splat.pos,1)).xyz;
    float4 centerClipPos = mul(_MatrixVP, float4(centerWorldPos, 1));
    half opacityScale = _SplatOpacityScale;
    float splatScale = _SplatScale;

    view.pos.x = asfloat(0x7f800000u); // culled unless a visible center is written below
    bool behindCam = centerClipPos.w <= 0;
    if (!behindCam)
    {
        float4 boxRot = splat.rot;
        float3 boxSize = splat.scale;

        float3x3 splatRotScaleMat = CalcMatrixFromRotationScale(boxRot, boxSize);

        float3 cov3d0, cov3d1;
        CalcCovariance3D(splatRotScaleMat, cov3d0, cov3d1);
        float splatScale2 = splatScale * splatScale;
        cov3d0 *= splatScale2;
        cov3d1 *= splatScale2;
        float3 cov2d = CalcCovariance2D(splat.pos, cov3d0, cov3d1, _MatrixMV, _MatrixP, _VecScreenParams);
        
        float2 axis1, axis2;
        DecomposeCovariance(cov2d, axis1, axis2);

        // frustum culling:
        // quad corners are +/-2 along each axis, then
        // pixels are converted to clip space by 2 / screen size * w
        float2 extentClip = 4 * (abs(axis1) + abs(axis2)) / _VecScreenParams.xy * centerClipPos.w;
        bool outsideView = any(abs(centerClipPos.xy) > centerClipPos.w + extentClip);
        if (!outsideView)
        {
            view.pos = centerClipPos.xyz / centerClipPos.w;
            view.axis1 = f32tof16(axis1.x) | (f32tof16(axis1.y) << 16);
            view.axis2 = f32tof16(axis2.x) | (f32tof16(axis2.y) << 16);
            // load color / SH only for splats that passed frustum culling
            LoadSplatColor(idx, splat);
            float3 worldViewDir = _VecWorldSpaceCameraPos.xyz - centerWorldPos;
            float3 objViewDir = mul((float3x3)_MatrixWorldToObject, worldViewDir);
            objViewDir = normalize(objViewDir);

            half4 col;
            col.rgb = ShadeSH(splat.sh, objViewDir, _SHOrder, _SHOnly != 0);
            col.a = min(splat.opacity * opacityScale, 65000);

            // —— S2P M7 T7.1/T7.2:最短轴法线 + 多光源 Lambert/Blinn-Phong 动态重光照 ——
            if (_S2PDynamicLightCount > 0 && _S2PPerSplatLightStrength > 0.0)
            {
                float3x3 o2wIT = transpose((float3x3)_MatrixWorldToObject);
                float3 nWorld;
                float flatness;
                ExtractSplatNormalAndFlatness(splat.rot, splat.scale, o2wIT, worldViewDir, nWorld, flatness);
                float3 vDir = normalize(worldViewDir);
                // flatness 关键权重:扁平硬表面 → 完全按法线;球状雾气/绒毛(flatness→0)→ 退化为无方向项,避免噪点
                float normalWeight = flatness * _S2PSplatNormalWeight;
                [loop]
                for (int li = 0; li < _S2PDynamicLightCount; ++li)
                {
                    float3 lVec = _S2PGpuLightA[li].xyz - centerWorldPos;
                    float distSq = dot(lVec, lVec);
                    float dist = sqrt(distSq);
                    float3 L = dist > 1e-5 ? lVec / dist : float3(0.0, 1.0, 0.0);
                    // 平方衰减:t = saturate(1 - d²/range²),atten = t²
                    float tAtten = saturate(1.0 - distSq * _S2PGpuLightA[li].w);
                    float atten = tAtten * tAtten;
                    // 聚光灯锥形(w < -0.999 为点光源)
                    float cosHalf = _S2PGpuLightB[li].w;
                    float spotFactor = cosHalf > -0.999
                        ? smoothstep(cosHalf, cosHalf + 0.08, dot(L, _S2PGpuLightB[li].xyz))
                        : 1.0;
                    // Lambert 漫反射(flatness 混合)
                    float ndotl = max(dot(nWorld, L), 0.0);
                    float diffuseK = lerp(1.0, ndotl, normalWeight);
                    // Blinn-Phong 镜面:shininess 随扁平度自适应(球状高斯无高光)
                    float3 H = normalize(L + vDir);
                    float shininess = lerp(1.0, _S2PGpuLightC[li].w, normalWeight);
                    float spec = pow(saturate(dot(nWorld, H)), shininess) * normalWeight;
                    float wLight = atten * spotFactor * _S2PPerSplatLightStrength;
                    col.rgb += (_S2PGpuLightC[li].rgb * (diffuseK * col.rgb) + _S2PGpuLightC[li].rgb * spec) * wLight;
                }
            }
            view.color.x = (f32tof16(col.r) << 16) | f32tof16(col.g);
            view.color.y = (f32tof16(col.b) << 16) | f32tof16(col.a);
        }
    }
    
    uint outputIndex = _SplatOffset + idx;
    _SplatViewData[outputIndex] = view;
    if (_WriteSortKeys != 0)
    {
        float depth = -mul(_MatrixMV, float4(splat.pos, 1)).z;
        _SplatSortDistances[outputIndex] = FloatToSortableUint(depth);
        _SplatSortKeys[outputIndex] = outputIndex;
    }
}
